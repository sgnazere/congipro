# Serveur
PORT=3001
NODE_ENV=development
# Origines du frontend autorisées par CORS (séparées par des virgules).
# En production, seules ces origines sont acceptées (localhost est refusé).
FRONTEND_URL=http://localhost:5173
# Derrière un reverse proxy (nginx, IIS) : true, ou le nombre de proxys
TRUST_PROXY=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=congipro
DB_USER=postgres
DB_PASS=changer_moi
DB_SSL=false

# JWT : deux secrets longs, aléatoires et différents
# (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=changer_moi
JWT_REFRESH=changer_moi_aussi

# Licence
LICENSE_MASTER_KEY=changer_moi

# Justificatifs (par défaut backend/uploads)
UPLOAD_DIR=

# Limites anti-abus (par fenêtre de 15 min) — valeurs par défaut adaptées à ~1000 utilisateurs derrière une même IP
# RATE_LIMIT_PER_USER=1500
# RATE_LIMIT_PER_IP=100000
# RATE_LIMIT_ANON_IP=5000
# RATE_LIMIT_LOGIN_ACCOUNT=10

# Relances de retour : « false » si elles tournent en tâche planifiée (npm run job:reminders)
# REMINDERS_IN_API=true
